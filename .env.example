# ══════════════════════════════════════════════════════════════════════════
#  .env.example — Plantilla de configuración del proyecto WordPress Docker
#  Copia este archivo como '.env' antes de ejecutar docker compose:
#    cp .env.example .env
#  O ejecuta el script automatizado:
#    ./docker/scripts/init-env.sh
# ══════════════════════════════════════════════════════════════════════════

# ── Identificación del Proyecto y Contenedores ────────────────────────────
# Nombre único para el proyecto de Compose (aísla redes y volúmenes)
COMPOSE_PROJECT_NAME=wordpress_project

# Prefijo para los nombres de los contenedores (ej: wp-app, wp-db)
CONTAINER_PREFIX=wp

# ── Servidor Web y Red ───────────────────────────────────────────────────
# Puerto en el host donde escuchará WordPress (http://localhost:APP_PORT)
APP_PORT=8080

# Zona horaria del sistema y PHP
APP_TIMEZONE=America/Caracas

# ── Mapeo de Permisos Linux (Host <-> Contenedor) ─────────────────────────
# Ejecuta 'id -u' e 'id -g' en tu terminal Linux para verificar tus IDs.
# Esto asegura que los archivos creados en wp-content pertenezcan a tu usuario.
PUID=1000
PGID=1000

# ── Versiones de Imágenes (Compatibilidad PHP / WordPress) ───────────────
# Cambia la versión de PHP o WordPress aquí y ejecuta 'docker compose build'
# Opciones disponibles en Docker Hub:
#   - wordpress:php8.3-apache
#   - wordpress:php8.2-apache (Recomendada estable)
#   - wordpress:php8.1-apache
#   - wordpress:6.7-php8.2-apache
WP_IMAGE=wordpress:6.7-php8.2-apache

# Motor de Base de Datos (MariaDB LTS recomendada)
DB_IMAGE=mariadb:11.4

# ── Base de Datos ────────────────────────────────────────────────────────
DB_NAME=wordpress_db
DB_USER=wordpress_user
DB_PASSWORD=genera_una_contrasena_segura_aqui
DB_ROOT_PASSWORD=genera_una_contrasena_root_segura_aqui

# Prefijo de tablas de WordPress (cambiar 'wp_' mejora la seguridad contra SQLi)
WORDPRESS_TABLE_PREFIX=wp_

# ── Llaves y Salts Criptográficos de WordPress ───────────────────────────
# Puedes generarlas automáticamente con ./docker/scripts/init-env.sh
# o visitando: https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY='generar_llave_unica_segura_aqui'
WORDPRESS_SECURE_AUTH_KEY='generar_llave_unica_segura_aqui'
WORDPRESS_LOGGED_IN_KEY='generar_llave_unica_segura_aqui'
WORDPRESS_NONCE_KEY='generar_llave_unica_segura_aqui'
WORDPRESS_AUTH_SALT='generar_llave_unica_segura_aqui'
WORDPRESS_SECURE_AUTH_SALT='generar_llave_unica_segura_aqui'
WORDPRESS_LOGGED_IN_SALT='generar_llave_unica_segura_aqui'
WORDPRESS_NONCE_SALT='generar_llave_unica_segura_aqui'
